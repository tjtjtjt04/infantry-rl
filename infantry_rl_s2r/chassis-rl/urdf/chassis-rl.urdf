  <!--
    Closed chain (five-bar wheel-leg): the wheel axle also sits in the back calf's axle hole.
    Represented with the Isaac Sim <loop_joint> URDF extension (isaacsim.asset.importer.urdf
    >= 2.1.0), exactly as in assets/infantry-rl/urdf/infantry-rl-sim.urdf.  The importer turns
    each one into a PhysicsSphericalJoint OUTSIDE the articulation, so PhysX enforces the loop
    as a real constraint instead of rejecting a closed articulation.  Each link contributes the
    axle-centre point in its own link frame, computed from this URDF's tree at q = 0 (the CAD
    assembly pose).  No other physical property of this URDF was modified.
  -->
  <loop_joint name="left_calf_axle" type="spherical">
    <link1 link="left_wheel" rpy="0 0 0" xyz="0.00000000 0.00000000 0.00000000" />
    <link2 link="left_back_calf" rpy="0 0 0" xyz="0.21773000 0.03494500 -0.15966200" />
  </loop_joint>
  <loop_joint name="right_calf_axle" type="spherical">
    <link1 link="right_wheel" rpy="0 0 0" xyz="0.00000000 0.00000000 0.00000000" />
    <link2 link="right_back_calf" rpy="0 0 0" xyz="-0.21772998 0.03494390 -0.15966200" />
  </loop_joint>
